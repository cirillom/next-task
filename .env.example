# Copy this file to .env for local Docker Compose or adapt it to the
# homeserver's deployment environment file (see README.md).
# Use the actual public HTTPS origin when available, with no trailing path.
# For local-only testing, use http://localhost:8000 instead.
NEXT_TASK_PUBLIC_APP_URL=https://tasks.example.com

# Gmail SMTP: use your Gmail address for username and sender.
# Use a Google App Password for the password, not your Google password.
NEXT_TASK_SMTP_HOST=smtp.gmail.com
NEXT_TASK_SMTP_PORT=587
NEXT_TASK_SMTP_SECURITY=starttls
NEXT_TASK_SMTP_USERNAME=you@gmail.com
NEXT_TASK_SMTP_PASSWORD=your-google-app-password
NEXT_TASK_SMTP_FROM_EMAIL=you@gmail.com

# Existing installations must retain their current credential secret.
# On a fresh production installation, generate a random value of at least
# 32 characters and keep it unchanged across deployments.
# NEXT_TASK_CREDENTIAL_SECRET=replace-with-a-stable-random-secret
